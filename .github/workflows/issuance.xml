name: Issuance
on: 
  - pull_request
  - issues
jobs:
  issue_msg:
    runs-on: windows-latest
    steps:
    - uses: actions/first-interaction@v1
      with:
        repo-token: ${{ secrets.GITHUB_TOKEN }}
        issue-message: 'Congrats on your first issue!'
        pr-message: 'Congrats on your first Pull request!'